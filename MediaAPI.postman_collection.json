            "item": [
                {
                    "name": "Upload Image",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "X-API-Key",
                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": [],
                                    "description": "Select an image file to upload"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/media/images?fileName={{sampleImageName}}&authorId={{authorId}}&description={{imageDescription}}&altText={{imageAltText}}&purpose=coverImage&contentId={{contentId}}&relatedContentType={{relatedContentType}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["media", "images"],
                            "query": [
                                {
                                    "key": "fileName",
                                    "value": "{{sampleImageName}}"
                                },
                                {
                                    "key": "authorId",
                                    "value": "{{authorId}}"
                                },
                                {
                                    "key": "description",
                                    "value": "{{imageDescription}}"
                                },
                                {
                                    "key": "altText",
                                    "value": "{{imageAltText}}"
                                },
                                {
                                    "key": "purpose",
                                    "value": "coverImage"
                                },
                                {
                                    "key": "contentId",
                                    "value": "{{contentId}}"
                                },
                                {
                                    "key": "relatedContentType",
                                    "value": "{{relatedContentType}}"
                                }
                            ]
                        },
                        "description": "Upload an image file with metadata. Use multipart/form-data with the image file in the body."
                    },
                    "response": []
                },
