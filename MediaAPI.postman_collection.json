    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set dynamic values if not already set",
                    "if (!pm.collectionVariables.get('mediaId')) {",
                    "    pm.collectionVariables.set('mediaId', 'sample-media-123');",
                    "}",
                    "",
                    "if (!pm.collectionVariables.get('imageMediaId')) {",
                    "    pm.collectionVariables.set('imageMediaId', 'image-media-456');",
                    "}",
                    "",
                    "if (!pm.collectionVariables.get('videoMediaId')) {",
                    "    pm.collectionVariables.set('videoMediaId', 'video-media-789');",
                    "}",
                    "",
                    "if (!pm.collectionVariables.get('contentId')) {",
                    "    pm.collectionVariables.set('contentId', 'content-123');",
                    "}",
                    "",
