{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            }
        },
        "logLevel": {
            "default": "Information",
            "Function": "Trace",
            "Host.Results": "Information",
            "Host.Aggregator": "Information",
            "Utils.Validation": "Trace",
            "Functions.Authors": "Trace",
            "Functions.GitHub": "Trace",
            "Functions.ContactMe": "Trace",
            "SharedStorage.Services.Email": "Trace"
        }
    },
    "extensions": {
        "http": {
            "routePrefix": ""
        }
    }
}
