        "version": "1.0.0"
    },
    "auth": {
        "type": "apikey",
        "apikey": [
            {
                "key": "key",
                "value": "x-api-key",
                "type": "string"
            },
            {
                "key": "value",
                "value": "{{API_KEY}}",
                "type": "string"
            },
            {
                "key": "in",
                "value": "header",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "BASE_URL",
            "value": "https://{{ENVIRONMENT}}-api.terencewaters.com",
            "type": "string",
            "description": "API URL - use ENVIRONMENT variable to switch between mock-dev, mock-tst, or api (prod)"
        },
        {
            "key": "LOCAL_URL",
            "value": "http://localhost:7071",
            "type": "string",
            "description": "Local development URL - use this value in BASE_URL for local testing"
        },
        {
            "key": "ENVIRONMENT",
            "value": "mock-dev",
            "type": "string",
            "description": "Environment prefix: mock-dev, mock-tst, or api (for production)"
        },
        {
            "key": "API_KEY",
            "value": "your-api-key-here",
            "type": "string"
        }
    ],
